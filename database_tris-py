def get_connection():
    """Crea la connessione al database"""
    return pymysql.connect(**DB_CONFIG)

def esegui_select(query, params=()):
    """Serve per LEGGERE i dati (es: Classifica o statistiche)"""
    conn = get_connection()
    try:
        with conn.cursor() as cursor:
            cursor.execute(query, params)
            return cursor.fetchall()
    finally:
        conn.close()

def esegui_dml(query, params=()):
    """Serve per SCRIVERE i dati (es: Salvare una partita o un nuovo giocatore)"""
    conn = get_connection()
    try:
        with conn.cursor() as cursor:
            cursor.execute(query, params)
            conn.commit()
            return cursor.rowcount
    finally:
        conn.close()
